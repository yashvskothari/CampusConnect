DATABASE_URL=postgresql://your-neon-string

JWT_SECRET=mySuperSecret123

JWT_EXPIRES=7d

PORT=5000

CLIENT_URL=http://localhost:5173

FRONTEND_URL=http://localhost:5173

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-smtp-user
EMAIL_PASSWORD=your-smtp-password
EMAIL_FROM=Gigverse AI <no-reply@example.com>

# Where chat attachments are stored. On Render, point this at a persistent disk (e.g. /var/data/attachments)
# otherwise files are lost on every redeploy.
ATTACHMENT_DIR=

# Razorpay Payment Gateway Configuration (India - INR)
# Obtain these from: https://dashboard.razorpay.com/#/app/keys (API Keys)
# Webhook secret from: https://dashboard.razorpay.com/#/app/webhooks
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
